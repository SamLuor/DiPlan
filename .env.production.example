# Template do .env usado pelo docker-compose.prod.yml na instância EC2.
# Copie para `.env.production` na instância e preencha os valores reais —
# esse arquivo NUNCA deve ser commitado (fica de fora do git, igual o .env de dev).

POSTGRES_USER=gestao_entregas
# Gere uma senha forte, ex.: `openssl rand -hex 24`
POSTGRES_PASSWORD=
POSTGRES_DB=gestao_entregas

# Gere com `openssl rand -hex 32`
SESSION_SECRET=

# URL pública da aplicação — IP elástico da instância (http://SEU_IP) ou o domínio,
# se/quando configurar um (ex.: https://entregas.suaempresa.com)
APP_URL=

# E-mail transacional (Resend). Sem isso, o link de definição de senha só fica no
# log do container (`docker compose -f docker-compose.prod.yml logs app`).
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Upload de anexos (S3). Sem chave/segredo aqui de propósito — o container usa a IAM role
# anexada à instância EC2 (ver domain-info/deploy-aws-ec2.md, passo do S3/IAM role).
AWS_REGION=us-east-1
S3_BUCKET_NAME=
