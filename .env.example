# Postgres (usado pelo docker-compose.yml e pela app)
POSTGRES_USER=gestao_entregas
POSTGRES_PASSWORD=gestao_entregas
POSTGRES_DB=gestao_entregas
POSTGRES_PORT=5432

# String de conexão usada pela app (drizzle) — precisa bater com as variáveis acima
DATABASE_URL=postgresql://gestao_entregas:gestao_entregas@localhost:5432/gestao_entregas

# Segredo usado para assinar/gerar tokens de sessão. Gere um valor forte, ex.: `openssl rand -hex 32`
SESSION_SECRET=troque-este-valor-em-producao

# URL pública da app, usada para montar o link de definição de senha nos e-mails
APP_URL=http://localhost:3000

# E-mail transacional (definição de senha por convite / esqueci minha senha).
# Sem RESEND_API_KEY, o mailer só loga o link no console do servidor (ver
# src/server/infra/email/mailer.server.ts) — útil em dev sem gastar envio real.
RESEND_API_KEY=
# Em sandbox (sem domínio verificado no Resend), onboarding@resend.dev só entrega
# para o e-mail da própria conta Resend — troque para um endereço do seu domínio
# verificado em produção.
RESEND_FROM=onboarding@resend.dev